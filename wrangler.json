{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wayfarer",
  "main": "worker/session.mjs",
  "compatibility_date": "2026-05-25",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wayfarer-db",
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "wayfarer-art"
    }
  ]
}
